---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ReadProgress from '../../components/ReadProgress.astro';
import { formatDate } from '../../lib/stages';

export async function getStaticPaths() {
  const news = (await getCollection('aktuality')).sort((a, b) => +b.data.date - +a.data.date);
  return news.map((item) => ({
    params: { slug: item.id },
    props: { item, others: news.filter((n) => n.id !== item.id).slice(0, 3) },
  }));
}
interface Props {
  item: CollectionEntry<'aktuality'>;
  others: CollectionEntry<'aktuality'>[];
}
const { item, others } = Astro.props;
const { Content } = await render(item);
---
<Base title={item.data.title} description={item.data.excerpt}>
  <ReadProgress target="#clanek" />
  <article class="wrap article" id="clanek">
    <a class="back" href="/aktuality/"><Icon name="arrow-left" size={16} /> Všechny aktuality</a>
    <header class="article__head">
      <time class="mono" datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
      <h1 class="article__title">{item.data.title}</h1>
      <p class="lead">{item.data.excerpt}</p>
    </header>
    <figure class="article__img frame">
      <Image src={item.data.image} alt="" widths={[720, 1080, 1440]} sizes="(min-width: 1100px) 1000px, 94vw" loading="eager" fetchpriority="high" />
    </figure>
    <div class="prose article__body">
      <Content />
    </div>
  </article>

  <section class="section wrap more" aria-labelledby="more-title">
    <h2 class="h3" id="more-title">Další aktuality</h2>
    <ol class="more__list">
      {
        others.map((n) => (
          <li>
            <a href={`/aktuality/${n.id}/`}>
              <time class="mono" datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
              <span>{n.data.title}</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .article {
    padding-top: var(--space-6);
    display: grid;
    gap: var(--space-6);
    max-width: calc(1000px + var(--gutter) + var(--gutter-r));
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 560;
    font-size: 0.9375rem;
    text-decoration: none;
    width: fit-content;
  }

  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      text-decoration: underline;
      text-decoration-color: var(--orange);
    }
  }

  .article__head {
    display: grid;
    gap: var(--space-4);
  }

  .article__head time {
    color: var(--muted);
  }

  .article__title {
    font-size: var(--t-xl);
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  .article__img {
    margin: 0;
    aspect-ratio: 16 / 9;
  }

  .article__body {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .more {
    max-width: calc(1000px + var(--gutter) + var(--gutter-r));
    padding-top: var(--space-7);
  }

  .more__list {
    list-style: none;
    margin-top: var(--space-4);
  }

  .more__list li + li {
    border-top: 1px solid var(--line);
  }

  .more__list a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    padding: 1rem 0;
    text-decoration: none;
    font-weight: 600;
  }

  .more__list time {
    color: var(--muted);
    font-weight: 400;
  }

  @media (hover: hover) and (pointer: fine) {
    .more__list a:hover span {
      color: var(--orange-lo);
    }
  }

  @media (max-width: 560px) {
    .more__list a {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .more__list time {
      grid-column: 1 / -1;
    }
  }
</style>
