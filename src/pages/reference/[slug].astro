---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import StageBar from '../../components/StageBar.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import RefCard from '../../components/RefCard.astro';
import Icon from '../../components/Icon.astro';
import { categories } from '../../content.config';
import { realizaceLabel } from '../../lib/stages';

export async function getStaticPaths() {
  const refs = (await getCollection('reference')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'cs'));
  return refs.map((item, i) => ({
    params: { slug: item.id },
    props: {
      item,
      prev: refs[(i - 1 + refs.length) % refs.length],
      next: refs[(i + 1) % refs.length],
      index: i + 1,
      total: refs.length,
      related: refs.filter((r) => r.data.category === item.data.category && r.id !== item.id).slice(0, 3),
    },
  }));
}

interface Props {
  item: CollectionEntry<'reference'>;
  prev: CollectionEntry<'reference'>;
  next: CollectionEntry<'reference'>;
  index: number;
  total: number;
  related: CollectionEntry<'reference'>[];
}
const { item, prev, next, index, total, related } = Astro.props;
const d = item.data;
const pad = (x: number) => String(x).padStart(2, '0');
---
<Base
  title={d.title}
  description={`${d.title} – ${categories[d.category]}. Rozsah prací IM Projektu: ${d.services.join(', ')}.`}
>
  <div class="wrap detail">
    <div class="detail__top">
      <a class="back" href="/reference/"><Icon name="arrow-left" size={16} /> Všechny reference</a>
      <nav class="pager" aria-label="Další reference">
        <a href={`/reference/${prev.id}/`} class="pager__link" title={prev.data.title} aria-label={`Předchozí reference: ${prev.data.title}`}>
          <Icon name="arrow-left" />
          <span class="pager__dir">Předchozí</span>
        </a>
        <span class="pager__count mono">{pad(index)} / {total}</span>
        <a href={`/reference/${next.id}/`} class="pager__link" title={next.data.title} aria-label={`Další reference: ${next.data.title}`}>
          <span class="pager__dir">Další</span>
          <Icon name="arrow" />
        </a>
      </nav>
    </div>

    <Sheet underlay={false}>
      <div class="detail__grid">
        <figure class="detail__img frame">
          <Image
            src={d.image}
            alt={d.title}
            widths={[720, 1080, 1440, 1920]}
            sizes="(min-width: 1100px) 62vw, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>

        <div class="detail__side">
          <h1 class="detail__title">{d.title}</h1>
          <div class="detail__scope-list">
            <h2 class="detail__h">Rozsah prací</h2>
            <ol class="scope">
              {
                d.services.map((s) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{s}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          {
            d.notes.length > 0 && (
              <div class="detail__scope-list">
                <h2 class="detail__h">Poznámka</h2>
                <ul class="detail__notes">
                  {d.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <div class="detail__meta">
          <TitleBlock
            rows={[
              { label: 'Autor návrhu', value: d.autor ?? '–' },
              { label: 'Kategorie', value: categories[d.category] },
              { label: 'Realizace', value: d.realizace ? realizaceLabel[d.realizace] : '–' },
            ]}
          />
        </div>
      </div>

      <div class="detail__scope">
        <div class="detail__scope-path">
          <h2 class="detail__h">Cesta projektu</h2>
          <StageBar services={d.services} labels class="detail__stages" />
        </div>
      </div>
    </Sheet>

  </div>

  {
    related.length > 0 && (
      <section class="section wrap related" aria-labelledby="related-title">
        <div class="related__head">
          <h2 class="h2" id="related-title">
            Další projekty: {categories[d.category].toLowerCase()}
          </h2>
          <a class="btn btn--ghost" href={`/reference/?kategorie=${d.category}`}>
            Celá kategorie <Icon name="arrow" />
          </a>
        </div>
        <div class="related__grid">
          {related.map((r) => <RefCard item={r} />)}
        </div>
      </section>
    )
  }
</Base>

<style>
  .detail {
    padding-top: var(--space-5);
  }

  /* back link and the previous / next project on one line above the sheet: no scrolling to move on */
  .detail__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-4);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 560;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      text-decoration: underline;
      text-decoration-color: var(--orange);
    }
  }

  .detail__grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1rem, 3vw, 2.5rem);
    background: var(--sheet);
  }

  /* photo with the title block under it, title and scope beside both: the long scope list
     no longer leaves a hole under the photo */
  .detail__grid {
    grid-template-areas:
      'img side'
      'meta side';
    grid-template-rows: auto 1fr;
    row-gap: var(--space-6);
  }

  .detail__img {
    grid-area: img;
    margin: 0;
    aspect-ratio: 1920 / 1194;
  }

  .detail__meta {
    grid-area: meta;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  /* author gets the most room: names run long */
  .detail__meta :global(.tb) {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1.4fr) minmax(0, 1fr);
  }

  .detail__meta :global(.tb__cell) {
    align-content: start;
  }

  .detail__side {
    grid-area: side;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .detail__title {
    font-size: var(--t-xl);
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .detail__notes {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .detail__notes li {
    display: grid;
    grid-template-columns: 10px minmax(0, 1fr);
    gap: 0.7rem;
    padding: 0.75rem 0;
    font-weight: 560;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .detail__notes li + li {
    border-top: 1px solid var(--line);
  }

  .detail__notes li::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--orange-lo);
    margin-top: 0.35em;
  }

  .detail__scope {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding: clamp(1rem, 3vw, 2.5rem);
    border-top: 1px solid var(--ink);
  }

  .detail__scope-path {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .detail__h {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 620;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }

  .detail__scope :global(.detail__stages .stages__mark) {
    width: 16px;
    height: 16px;
  }

  .detail__scope :global(.detail__stages .stages__track::before) {
    top: 8px;
  }

  .detail__scope :global(.detail__stages .stages__label) {
    font-size: 0.8125rem;
  }

  .scope {
    list-style: none;
  }

  .scope li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 0.6rem;
    padding: 0.7rem 0;
  }

  .scope li:first-child {
    padding-top: 0;
  }

  .scope li + li {
    border-top: 1px solid var(--line);
  }

  .scope :global(svg) {
    color: var(--orange-lo);
    margin-top: 0.2rem;
  }

  .pager {
    display: flex;
    border: 1px solid var(--ink);
    background: var(--sheet);
  }

  .pager__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.85rem;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: background-color 0.2s var(--ease-out);
  }

  .pager__dir {
    font-weight: 620;
  }

  /* sheet number between the arrows, like the list number in a drawing set */
  .pager__count {
    display: flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border-inline: 1px solid var(--ink);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .pager__link:hover {
      background: var(--orange);
    }
  }

  .related__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 1000px) {
    .detail__grid,
    .detail__scope {
      grid-template-columns: 1fr;
    }

    .detail__grid {
      grid-template-areas: 'img' 'side' 'meta';
      grid-template-rows: none;
    }

    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .detail__meta :global(.tb) {
      grid-template-columns: 1fr;
    }

    .related__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
