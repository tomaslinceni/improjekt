---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Icon from '../components/Icon.astro';
import { company, people } from '../data/site';
const tel = (p: string) => p.replace(/\s/g, '');
---
<Base title="Kontakty" description="IM Projekt spol. s r. o., náměstí Míru 13, 293 01 Mladá Boleslav. Telefon +420 326 322 571, info@improjekt.cz.">
  <PageHead title="Jsme vám k dispozici" lead="v naší kanceláři v Mladé Boleslavi">
    <div class="central">
      <a class="central__big" href={`tel:${company.phoneHref}`}><Icon name="phone" size={22} />{company.phone}</a>
      <a class="central__big" href={`mailto:${company.email}`}><Icon name="mail" size={22} />{company.email}</a>
    </div>
    <Fragment slot="aside">
      <div class="seat glass">
        <svg class="seat__north" viewBox="0 0 60 80" aria-hidden="true">
          <circle cx="30" cy="44" r="22" />
          <path d="M30 14L40 58L30 50L20 58Z" />
          <text x="30" y="10">S</text>
        </svg>
        <p class="seat__label">Sídlo společnosti</p>
        <p class="seat__name">{company.name}</p>
        <address>
          {company.street}<br />
          {company.city}
        </address>
        <a class="link-arrow" href={company.mapy} target="_blank" rel="noopener">
          <Icon name="pin" />
          Otevřít v Mapy.cz
        </a>
      </div>
    </Fragment>
  </PageHead>

  <section class="section wrap people" aria-labelledby="people-title">
    <h2 class="h2" id="people-title">Kontaktní osoby</h2>
    <ul class="people__list">
      {
        people.map((p) => (
          <li class="person">
            <p class="person__name">{p.name}</p>
            <p class="person__role">{p.role}</p>
            <p class="person__links">
              <a class="mono" href={`mailto:${p.email}`}>
                <Icon name="mail" size={18} />
                {p.email}
              </a>
              {p.phones.map((ph) => (
                <a class="mono" href={`tel:${tel(ph)}`}>
                  <Icon name="phone" size={18} />
                  {ph}
                </a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="billing">
      <h2 class="h3">Fakturační údaje</h2>
      <TitleBlock
        rows={[
          { label: 'Společnost', value: company.name, wide: true },
          { label: 'IČ', value: company.ic, mono: true },
          { label: 'DIČ', value: company.dic, mono: true },
          { label: 'Číslo účtu', value: company.account, mono: true, wide: true },
          { label: 'Obchodní rejstřík', value: company.register, wide: true },
        ]}
      />
    </div>
  </section>
</Base>

<style>
  .central {
    display: grid;
    gap: var(--space-2);
  }

  .central__big {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--f-mono);
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.625rem);
    font-weight: 500;
    text-decoration: none;
    width: fit-content;
  }

  @media (hover: hover) and (pointer: fine) {
    .central__big:hover {
      text-decoration: underline;
      text-decoration-color: var(--orange);
    }
  }

  .seat {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .seat {
    position: relative;
  }

  /* G4: north arrow on the address, as on a site plan */
  .seat__north {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 48px;
    height: auto;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .seat__north path {
    fill: var(--orange);
  }

  .seat__north text {
    fill: var(--ink);
    stroke: none;
    font-family: var(--f-mono);
    font-size: 12px;
    text-anchor: middle;
  }

  .seat__label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 620;
    color: var(--muted);
  }

  .seat__name {
    font-weight: 650;
    font-size: 1.125rem;
  }

  .seat address {
    font-style: normal;
    margin-bottom: var(--space-3);
  }

  .people {
    display: grid;
    grid-template-columns: var(--split);
    grid-template-rows: auto 1fr;
    gap: var(--space-5) var(--split-gap);
  }

  .people > h2 {
    grid-column: 1;
  }

  .people__list {
    grid-column: 1;
    list-style: none;
  }

  .person {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.2rem var(--space-5);
    padding: var(--space-5) 0;
  }

  .person:first-child {
    padding-top: var(--space-2);
  }

  .person + .person {
    border-top: 1px solid var(--line);
  }

  .person__name {
    font-size: var(--t-md);
    font-weight: 650;
  }

  .person__role {
    color: var(--muted);
    grid-column: 1;
  }

  .person__links {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }

  .person__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .person__links a:hover {
      text-decoration: underline;
      text-decoration-color: var(--orange);
    }
  }

  .billing {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .billing :global(.tb) {
    background: var(--sheet);
  }

  @media (max-width: 980px) {
    .people {
      grid-template-columns: 1fr;
    }

    .billing {
      grid-column: 1;
      grid-row: auto;
      margin-top: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .person {
      grid-template-columns: 1fr;
    }

    .person__links {
      grid-column: 1;
      grid-row: auto;
      margin-top: var(--space-3);
    }
  }
</style>
