  /* ---------- K2 fold ---------- */
  .k2-wrap {
    display: grid;
    place-items: center;
    padding: var(--space-6);
    background: var(--paper);
  }

  .k2 {
    --fold: 56px;
    position: relative;
    display: grid;
    gap: 0.75rem;
    width: min(380px, 100%);
    min-height: 260px;
    padding: 1.5rem;
    text-decoration: none;
    background: var(--sheet);
    border: 1px solid var(--ink);
    clip-path: polygon(0 0, calc(100% - var(--fold)) 0, 100% var(--fold), 100% 100%, 0 100%);
    transition: clip-path 0.45s var(--ease-out);
  }

  .k2__fold {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--fold);
    height: var(--fold);
    background: linear-gradient(225deg, transparent 50%, var(--paper-2) 50%);
