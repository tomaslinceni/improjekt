</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  // E1 progress kóta, E2/G2 plot drawing, E7 pinned track
  const progLine = document.querySelector<HTMLElement>('[data-progress-line]');
  const progLabel = document.querySelector<HTMLElement>('[data-progress-label]');
  const plots = [...document.querySelectorAll<HTMLElement>('[data-plot]')];
  const pin = document.querySelector<HTMLElement>('[data-pin]');
  const track = document.querySelector<HTMLElement>('[data-pin-track]');

  const measurePin = () => {
    if (pin && track) track.style.setProperty('--max', `${Math.max(0, track.scrollWidth - pin.clientWidth)}px`);
  };

  const frame = () => {
    const vh = window.innerHeight;
    const doc = document.documentElement;
    const p = clamp(window.scrollY / (doc.scrollHeight - vh));
    progLine?.parentElement?.style.setProperty('--p', String(p));
    progLine?.style.setProperty('--p', String(p));
    if (progLabel) progLabel.textContent = `${Math.round(window.scrollY * 2.5).toLocaleString('cs-CZ')} mm`;

    if (!reduce) {
      for (const el of plots) {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--p', String(clamp((vh - r.top) / (vh * 0.55 + r.height * 0.6))));
      }
      if (pin && track) {
        const r = pin.getBoundingClientRect();
        track.style.setProperty('--p', String(clamp(-r.top / (r.height - vh))));
      }
    }
  };

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      frame();
      ticking = false;
    });
  };
  measurePin();
  frame();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    measurePin();
    frame();
  });

  // E3 compare slider
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('[data-compare-range]');
    range?.addEventListener('input', () => el.style.setProperty('--pos', `${range.value}%`));
  });

  // E4 CAD crosshair, snapped to the 24px grid
  document.querySelectorAll<HTMLElement>('[data-cad]').forEach((el) => {
    const read = el.querySelector<HTMLElement>('[data-cad-read]');
    el.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = el.getBoundingClientRect();
      const x = Math.round((e.clientX - r.left) / 12) * 12;
      const y = Math.round((e.clientY - r.top) / 12) * 12;
      el.classList.add('is-on');
      el.style.setProperty('--x', `${x}px`);
      el.style.setProperty('--y', `${y}px`);
      if (read) read.textContent = `X ${(x * 50).toLocaleString('cs-CZ')} · Y ${((r.height - y) * 50).toLocaleString('cs-CZ')}`;
    });
    el.addEventListener('pointerleave', () => el.classList.remove('is-on'));
  });

  // E6 view transition card → detail
  document.querySelectorAll<HTMLElement>('[data-vt]').forEach((el) => {
    const detail = el.querySelector<HTMLElement>('[data-vt-detail]');
    const toggle = (open: boolean) => {
      const apply = () => {
        el.classList.toggle('is-open', open);
        if (detail) detail.hidden = !open;
      };
      const d = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (d.startViewTransition && !reduce) {
        // name the source first so the browser snapshots the right element
        el.classList.toggle('is-open', !open);
        d.startViewTransition(apply);
      } else apply();
    };
    el.querySelector('[data-vt-open]')?.addEventListener('click', () => toggle(true));
    el.querySelector('[data-vt-close]')?.addEventListener('click', () => toggle(false));
  });

  // One-shot reveals: E8 counters, E9 pen, K3 stamp
  const runCount = (group: Element) => {
    group.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
      const target = Number(n.dataset.count);
      const scale = n.nextElementSibling as HTMLElement | null;
      if (reduce) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const k = clamp((t - t0) / 1400);
        const e = 1 - Math.pow(1 - k, 3);
        n.textContent = String(Math.round(target * e));
        scale?.style.setProperty('--s', String(e));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  };
  const runPen = (el: Element) => {
    el.classList.remove('is-run');
    void (el as HTMLElement).offsetWidth;
    if (!reduce) el.classList.add('is-run');
  };
  const runStamp = (el: Element) => {
    el.classList.remove('is-stamped');
    void (el as HTMLElement).offsetWidth;
    el.classList.add('is-stamped');
  };

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        if (e.target.hasAttribute('data-count-group')) runCount(e.target);
        if (e.target.hasAttribute('data-pen')) runPen(e.target);
        if (e.target.hasAttribute('data-stamp')) runStamp(e.target);
      }
    },
    { threshold: 0.6 },
  );
  document.querySelectorAll('[data-count-group],[data-pen],[data-stamp]').forEach((el) => io.observe(el));
  document.querySelector('[data-pen-replay]')?.addEventListener('click', () => {
    const p = document.querySelector('[data-pen]');
    if (p) runPen(p);
  });
  document.querySelector('[data-stamp-replay]')?.addEventListener('click', () => {
    const s = document.querySelector('[data-stamp]');
    if (s) runStamp(s);
  });

  // S1 photo peek next to the cursor
  document.querySelectorAll<HTMLElement>('[data-peek]').forEach((el) => {
    const box = el.querySelector<HTMLElement>('[data-peek-box]');
    const imgs = [...el.querySelectorAll<HTMLElement>('[data-peek-img]')];
    el.querySelectorAll<HTMLElement>('[data-peek-row]').forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.peekImg === row.dataset.peekRow));
        el.classList.add('is-peek');
      });
    });
    el.addEventListener('pointermove', (e) => {
      if (!box) return;
      const r = el.getBoundingClientRect();
      const x = Math.min(e.clientX - r.left + 24, r.width - box.offsetWidth - 8);
      box.style.setProperty('--px', `${x}px`);
      box.style.setProperty('--py', `${e.clientY - r.top - box.offsetHeight / 2}px`);
    });
    el.addEventListener('pointerleave', () => el.classList.remove('is-peek'));
  });

  // S2 floors as tabs
  document.querySelectorAll<HTMLElement>('[data-floors]').forEach((el) => {
    const tabs = [...el.querySelectorAll<HTMLButtonElement>('[data-floor]')];
    const panels = [...el.querySelectorAll<HTMLElement>('[data-floor-panel]')];
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        panels.forEach((p) => (p.hidden = p.dataset.floorPanel !== t.dataset.floor));
      }),
    );
  });

  // S3 axis navigator: highlight the group in view
  const axisLinks = [...document.querySelectorAll<HTMLElement>('[data-axis]')];
  const axisIo = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        axisLinks.forEach((a) => a.classList.toggle('is-current', a.dataset.axis === e.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('.group').forEach((g) => axisIo.observe(g));
</script>
