    overflow: hidden;
    clip-path: inset(50% 0 50% 0);
    background:
      linear-gradient(var(--orange-lo), var(--orange-lo)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--orange-lo), var(--orange-lo)) 0 0 / 100% 1px no-repeat,
      linear-gradient(var(--orange-lo), var(--orange-lo)) 0 100% / 100% 1px no-repeat;
