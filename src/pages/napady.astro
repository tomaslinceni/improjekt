  }

  .k2:hover,
  .k2:focus-visible {
    clip-path: polygon(0 0, 100% 0, 100% 0, 100% 100%, 0 100%);
  }

  .k2:hover .k2__fold,
  .k2:focus-visible .k2__fold {
    width: 0;
    height: 0;
    opacity: 0;
  }

  .k2__date {
    font-size: var(--t-xs);
    color: var(--muted);
  }

  .k2__title {
    max-width: 16ch;
  }

  .k2__stamp {
    align-self: end;
    display: grid;
    grid-template-columns: auto auto;
    justify-content: end;
    gap: 0 0.75rem;
    font-size: 0.6875rem;
    border-top: 1px solid var(--ink);
    padding-top: 0.6rem;
    translate: 0 8px;
    opacity: 0;
    transition: translate 0.45s var(--ease-out), opacity 0.3s;
