  }

  .k1__name {
    font-weight: 620;
  }

  .k1__dim {
    position: absolute;
    font-size: 0.6875rem;
    color: var(--orange-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    opacity: 0;
    transition: opacity 0.3s, clip-path 0.5s var(--ease-out);
  }

  .k1__dim--top {
    left: 0;
    right: 0;
    top: -1.6rem;
    height: 1.2rem;
    clip-path: inset(0 50% 0 50%);
    background:
      linear-gradient(var(--orange-lo), var(--orange-lo)) 0 50% / 100% 1px no-repeat,
      linear-gradient(var(--orange-lo), var(--orange-lo)) 0 0 / 1px 100% no-repeat,
      linear-gradient(var(--orange-lo), var(--orange-lo)) 100% 0 / 1px 100% no-repeat;
  }

  .k1__dim--side {
    top: 0;
    right: -2.2rem;
    width: 1.2rem;
    aspect-ratio: auto;
    height: calc(100% - 2.2rem);
