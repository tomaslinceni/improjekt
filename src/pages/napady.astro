      repeating-linear-gradient(-45deg, var(--ink) 0 1px, transparent 1px 6px) 0 0 / 100% 50% no-repeat,
      repeating-linear-gradient(45deg, var(--ink) 0 1px, transparent 1px 14px) 0 100% / 100% 50% no-repeat;
