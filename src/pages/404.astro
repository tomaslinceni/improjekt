---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Stránka nenalezena" contact={false}>
  <PageHead title="Tahle stránka na výkrese chybí" lead="Odkaz je zastaralý nebo v adrese chybí znak. Zkuste začít od úvodu nebo od referencí.">
    <div class="actions">
      <a class="btn" href="/">Na úvod <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href="/reference/">Reference</a>
    </div>
  </PageHead>
  <div class="spacer"></div>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .spacer {
    height: var(--space-8);
  }
</style>
