---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('stranky');
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }));
}
interface Props {
  page: CollectionEntry<'stranky'>;
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title} contact={false}>
  <article class="wrap legal">
    <h1 class="legal__title">{page.data.title}</h1>
    <div class="prose legal__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: var(--space-7) var(--space-9);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    /* one narrow reading column, centred; the text fills it (no image here to widen the column) */
    max-width: calc(760px + var(--gutter) + var(--gutter-r));
  }

  .legal__title {
    font-size: var(--t-xl);
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .legal__body {
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: none;
  }

  /* cookie lists: one ruled table per service */
  .legal__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
    margin-block: var(--space-3) var(--space-5);
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }

  .legal__body :global(th) {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 620;
    color: var(--muted);
    border-bottom-color: var(--ink);
  }

  .legal__body :global(td:first-child) {
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
    width: 42%;
  }

  .legal__body :global(a),
  .legal__body :global(p) {
    overflow-wrap: anywhere;
  }
</style>
