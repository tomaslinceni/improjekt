---
/** Line pictograms for the four client groups, drawn on a 48px grid in the icon stroke. */
interface Props {
  id: string;
  size?: number;
}
const { id, size = 44 } = Astro.props;
const art: Record<string, string> = {
  developeri:
    '<path d="M6 42V18h10v24M16 42V10h12v32M28 42V22h10v20M3 42h42"/><path d="M9 23h4M9 28h4M9 33h4M19 15h6M19 20h6M19 25h6M19 30h6M31 27h4M31 32h4"/><path d="M33 22V6l10 4"/>',
  'stavebnici-jednotlivci':
    '<path d="M6 22L24 7l18 15M10 19v23h28V19M3 42h42"/><path d="M20 42V30h8v12"/><path d="M14 25h4v4h-4zM30 25h4v4h-4z"/>',
  'mesta-a-statni-instituce':
    '<path d="M5 17L24 7l19 10M7 17h34M9 21v16M17 21v16M31 21v16M39 21v16M5 37h38M3 42h42"/><path d="M21 37v-9h6v9"/>',
  'architekti-a-projektanti':
    '<path d="M6 42L42 6M6 42h36V6"/><path d="M15 33h18V15z"/><path d="M42 30h-5M42 22h-3M42 14h-5M14 42v-5M22 42v-3M30 42v-5"/>',
};
---
<svg
  class="aud-icon"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  aria-hidden="true"
  set:html={art[id] ?? ''}
/>
