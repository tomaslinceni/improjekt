---
import { Image } from 'astro:assets';
import Sheet from './Sheet.astro';
import Icon from './Icon.astro';
import heroImg from '../assets/brand/hero-old.webp';
---
<section class="hero wrap bleed" aria-labelledby="hero-title">
  <Sheet underlay={false} zones>
    <div class="hero__stage">
      <div class="hero__img">
        <Image
          src={heroImg}
          alt="Skica bytového domu s kótami, která plynule přechází ve fotografii hotové stavby"
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero__panel glass">
        <h1 class="display hero__title pen" id="hero-title">Partner pro vaši&nbsp;ideu</h1>
        <p class="lead hero__lead">
          Projektování je o hledání cest. My je pro vás nacházíme již více než 30&nbsp;let.
        </p>
        <div class="hero__actions">
          <a class="btn" href="#kontaktujte-nas">
            Konzultovat záměr
            <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost" href="/reference/">Prohlédnout reference</a>
        </div>
      </div>
    </div>
  </Sheet>
</section>

<style>
  .hero {
    padding-top: var(--space-5);
  }

  /* the picture is the whole sheet; the tracing-paper panel lies over the road at the bottom */
  .hero__stage {
    position: relative;
    height: clamp(560px, calc(100svh - var(--header-h) - 64px), 880px);
    display: flex;
    align-items: flex-end;
    --pad: clamp(1rem, 2.4vw, 2rem);
    padding: var(--pad) max(var(--pad), var(--col-inset));
  }

  .hero__img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #5e6063;
  }

  .hero__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* keep the sketched house with its dimensions and the seam to the photo in view */
    object-position: 32% 40%;
    transform-origin: 32% 40%;
  }

  .hero__panel {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'lead' 'actions';
    justify-items: start;
    gap: var(--space-4) var(--space-6);
    padding: clamp(1.1rem, 2.2vw, 1.75rem) clamp(1.25rem, 2.6vw, 2.25rem);
  }

  .hero__title {
    grid-area: title;
    font-size: clamp(2.4rem, 1.1rem + 3.6vw, 4.5rem);
  }

  .hero__lead {
    grid-area: lead;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    max-width: 36ch;
  }

  .hero__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /* the photograph eases closer as the page scrolls away */
      .hero__img :global(img) {
        animation: hero-zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
    }
  }

  @keyframes hero-zoom {
    to {
      scale: 1.07;
    }
  }

  @media (max-width: 760px) {
    .hero__stage {
      height: auto;
      display: block;
      padding: 0;
    }

    .hero__img {
      position: relative;
      aspect-ratio: 4 / 3;
    }

    .hero__img :global(img) {
      object-position: 30% 60%;
    }

    .hero__panel {
      width: auto;
      margin: -2.5rem 0.75rem 0.75rem;
    }
  }
</style>
