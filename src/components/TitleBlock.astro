---
/**
 * Rohové razítko – the title block from the corner of a drawing sheet.
 * Label/value rows in a ruled grid; values in mono when they are data.
 */
interface Row {
  label: string;
  value: string;
  mono?: boolean;
  wide?: boolean;
  /** makes the value itself the link (tel:, mailto:, map) */
  href?: string;
  external?: boolean;
}
interface Props {
  rows: Row[];
  class?: string;
  dark?: boolean;
}
const { rows, class: cls = '', dark = false } = Astro.props;
---
<dl class:list={['tb', { 'tb--dark': dark }, cls]}>
  {
    rows.map((r) => (
      <div class:list={['tb__cell', { 'tb__cell--wide': r.wide }]}>
        <dt class="tb__label">{r.label}</dt>
        <dd class:list={['tb__value', { mono: r.mono }]}>
          {r.href ? (
            <a class="tb__link" href={r.href} {...(r.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {r.value}
            </a>
          ) : (
            r.value
          )}
        </dd>
      </div>
    ))
  }
  <slot />
</dl>

<style>
  .tb {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .tb__cell {
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 0.45rem 0.7rem 0.55rem;
    min-width: 0;
    display: grid;
    gap: 0.1rem;
  }

  .tb__cell--wide {
    grid-column: 1 / -1;
  }

  .tb__label {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-stretch: 105%;
    font-weight: 560;
  }

  .tb__value {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 560;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .tb__value.mono {
    font-weight: 500;
    font-size: 0.875rem;
  }

  .tb__link {
    color: inherit;
    text-decoration: none;
  }

  .tb__link:focus-visible {
    outline: none;
  }

  /* the whole cell is the hit area */
  .tb__cell:has(.tb__link) {
    position: relative;
  }

  .tb__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tb__cell:has(.tb__link) {
    transition: background-color 0.2s var(--ease-out);
  }

  /* the cell turns orange: hover, and keyboard focus with the ring around the whole cell */
  .tb__cell:has(.tb__link:focus-visible) {
    background: var(--orange);
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .tb__cell:has(.tb__link:focus-visible) .tb__label {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .tb__cell:has(.tb__link):hover {
      background: var(--orange);
    }

    .tb__cell:has(.tb__link):hover .tb__label {
      color: var(--ink);
    }
  }

  .tb--dark {
    border-color: rgb(232 233 231 / 0.35);
  }

  .tb--dark .tb__cell {
    border-color: rgb(232 233 231 / 0.35);
  }

  .tb--dark .tb__label {
    color: var(--on-dark-muted);
  }
</style>
