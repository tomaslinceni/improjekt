---
/**
 * S3 – on long pages a vertical axis with numbered bubbles holds the left margin.
 * The bubble of the section in view turns orange; a click jumps there. Wide screens only.
 */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---
<nav class="axisnav" aria-label="Části stránky">
  <span class="axisnav__line" aria-hidden="true"></span>
  {
    items.map((it, i) => (
      <a href={`#${it.id}`} data-axis={it.id}>
        <span class="axisnav__bubble mono">{i + 1}</span>
        <span class="axisnav__label">{it.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .axisnav {
    display: none;
  }

  @media (min-width: 1500px) {
    .axisnav {
      position: fixed;
      left: calc((100vw - var(--wrap)) / 2 - 46px);
      top: 50%;
      translate: 0 -50%;
      z-index: 15;
      display: grid;
      gap: 1.4rem;
    }
  }

  .axisnav__line {
    position: absolute;
    left: 13px;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--line-strong);
  }

  .axisnav a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .axisnav__bubble {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--sheet);
    font-size: 0.6875rem;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .axisnav__label {
    font-size: var(--t-sm);
    font-weight: 560;
    white-space: nowrap;
    background: var(--sheet);
    border: 1px solid var(--ink);
    padding: 0.15rem 0.45rem;
    opacity: 0;
    translate: -4px 0;
    pointer-events: none;
    transition: opacity 0.2s, translate 0.2s;
  }

  .axisnav a:focus-visible .axisnav__label {
    opacity: 1;
    translate: 0 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .axisnav a:hover .axisnav__label {
      opacity: 1;
      translate: 0 0;
    }
  }

  .axisnav a.is-current .axisnav__bubble {
    background: var(--orange);
  }

  @media (hover: hover) and (pointer: fine) {
    .axisnav a:hover .axisnav__bubble {
      background: var(--orange);
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLElement>('[data-axis]')];
  if (links.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => {
            const on = a.dataset.axis === e.target.id;
            a.classList.toggle('is-current', on);
            if (on) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    links.forEach((a) => {
      const s = document.getElementById(a.dataset.axis!);
      if (s) io.observe(s);
    });
  }
</script>
