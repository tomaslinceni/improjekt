---
import { history, YEAR } from '../data/site';
/**
 * E7 – the company history along one long dimension line. On wide screens the section holds
 * still and scrolling moves the line sideways through time; on phones and with reduced motion
 * it is a plain list.
 */
---
<div class="htrack" data-htrack>
  <div class="htrack__sticky">
    <ol class="htrack__track" data-htrack-track>
      <li class="htrack__axis" aria-hidden="true">
        <span class="htrack__tick"></span>
        <span class="htrack__line"></span>
        <span class="htrack__end mono">{YEAR}</span>
      </li>
      {
        history.map((h) => (
          <li class="htrack__item">
            <h3 class="htrack__when">{h.when}</h3>
            <span class="htrack__dot" aria-hidden="true" />
            <p>{h.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .htrack__track {
    list-style: none;
    position: relative;
  }

  .htrack__item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .htrack__when {
    font-size: var(--t-lg);
    font-stretch: 112%;
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .htrack__dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--orange-lo);
  }

  .htrack__item:last-child .htrack__dot {
    background: var(--orange);
  }

  .htrack__item p {
    color: var(--ink-2);
    font-size: 0.9375rem;
    max-width: 40ch;
  }

  /* the long dimension line: tick at the start, the current year at the end */
  .htrack__axis {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--when-h) + var(--space-3) + 6px);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .htrack__tick {
    width: 14px;
    height: 14px;
    flex: none;
    margin-left: -7px;
    background: linear-gradient(135deg, transparent 44%, var(--orange-lo) 44% 56%, transparent 56%);
  }

  .htrack__line {
    flex: 1;
    height: 1.5px;
    background: var(--orange-lo);
  }

  .htrack__end {
    font-size: var(--t-xs);
    color: var(--orange-ink);
    padding-left: 0.5rem;
  }

  .htrack {
    --when-h: 2.2rem;
  }

  .htrack__when {
    min-height: var(--when-h);
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .htrack {
      height: 240vh;
      position: relative;
    }

    .htrack__sticky {
      position: sticky;
      top: var(--header-h);
      height: calc(100svh - var(--header-h));
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .htrack__track {
      display: flex;
      align-items: start;
      gap: var(--space-8);
      padding-right: 20vw;
      translate: calc(var(--p, 0) * var(--max, 0px) * -1) 0;
      will-change: translate;
    }

    .htrack__item {
      flex: 0 0 clamp(300px, 28vw, 400px);
    }
  }

  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .htrack {
      height: auto;
    }

    .htrack__sticky {
      position: static;
      height: auto;
      overflow-x: auto;
      padding-bottom: var(--space-5);
    }

    .htrack__track {
      translate: none;
    }
  }

  /* phones: vertical list along the same line */
  @media (max-width: 899px) {
    .htrack__track {
      border-left: 1.5px solid var(--orange-lo);
      margin-left: 6px;
      display: grid;
      gap: var(--space-6);
    }

    .htrack__axis {
      display: none;
    }

    .htrack__item {
      position: relative;
      padding-left: var(--space-5);
    }

    .htrack__dot {
      position: absolute;
      left: -8px;
      top: 0.55rem;
    }

    .htrack__when {
      min-height: 0;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-htrack]');
  const track = el?.querySelector<HTMLElement>('[data-htrack-track]');
  const wide = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
  if (el && track) {
    const measure = () => track.style.setProperty('--max', `${Math.max(0, track.scrollWidth - el.clientWidth)}px`);
    const update = () => {
      if (!wide.matches) return;
      const r = el.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - window.innerHeight)));
      track.style.setProperty('--p', String(p));
    };
    measure();
    update();
    window.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', () => {
      measure();
      update();
    });
  }
</script>
