---
/**
 * E2 – an elevation of a house that plots itself line by line, then gets its dimensions.
 * `mode="load"` draws once on page load, `mode="scroll"` follows the scroll.
 */
interface Props {
  mode?: 'load' | 'scroll';
  class?: string;
}
const { mode = 'load', class: cls = '' } = Astro.props;
---
<div class:list={['plot', cls]} data-plothouse={mode} aria-hidden="true">
  <svg viewBox="0 0 600 340">
    <g class="plot__ink">
      <path pathLength="1" style="--d:0" d="M20 300H580" />
      <path pathLength="1" style="--d:.05" d="M90 300V150H450V300" />
      <path pathLength="1" style="--d:.15" d="M70 160L270 50L470 160" />
      <path pathLength="1" style="--d:.25" d="M450 300V200H540V300" />
      <path pathLength="1" style="--d:.3" d="M440 205L495 170L550 205" />
      <path pathLength="1" style="--d:.38" d="M130 190h60v60h-60zM210 190h60v60h-60z" />
      <path pathLength="1" style="--d:.45" d="M320 210h52v90h-52z" />
      <path pathLength="1" style="--d:.5" d="M470 225h50v40h-50z" />
      <path pathLength="1" style="--d:.55" d="M160 190v60M240 190v60M130 220h60M210 220h60" class="thin" />
    </g>
    <g class="plot__dim">
      <path pathLength="1" style="--d:.7" d="M90 325H450M84 331l12-12M444 331l12-12M90 305v26M450 305v26" />
      <path pathLength="1" style="--d:.78" d="M565 300V50M559 56l12-12M559 306l12-12M545 50h26M545 300h26" />
    </g>
    <text x="270" y="320" class="plot__txt" style="--d:.85">12 000</text>
    <text x="578" y="180" class="plot__txt" style="--d:.9" transform="rotate(-90 578 180)">8 450</text>
  </svg>
</div>

<style>
  .plot svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .plot path {
    fill: none;
    stroke-linecap: square;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - clamp(0, (var(--p, 1) - var(--d)) * 4, 1));
  }

  .plot__ink path {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .plot__ink .thin {
    stroke-width: 1;
  }

  .plot__dim path {
    stroke: var(--orange-lo);
    stroke-width: 1.25;
  }

  .plot__txt {
    font-family: var(--f-mono);
    font-size: 14px;
    fill: var(--orange-ink);
    text-anchor: middle;
    opacity: clamp(0, (var(--p, 1) - var(--d)) * 8, 1);
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-plothouse]').forEach((el) => {
    if (reduce) return;
    if (el.dataset.plothouse === 'load') {
      el.style.setProperty('--p', '0');
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 2600);
          el.style.setProperty('--p', String(k));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
      io.observe(el);
    } else {
      const update = () => {
        const r = el.getBoundingClientRect();
        const vh = window.innerHeight;
        el.style.setProperty('--p', String(Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.55 + r.height * 0.6)))));
      };
      update();
      window.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    }
  });
</script>
