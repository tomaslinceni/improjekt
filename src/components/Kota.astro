---
/**
 * Kóta – a dimension line. The recurring element of the identity.
 * Extension lines and 45° slash ticks at both ends, the measured value in the middle.
 * `start` / `end` print values at the ends (e.g. years), `label` sits on the line.
 */
interface Props {
  label?: string;
  start?: string;
  end?: string;
  tone?: 'orange' | 'ink' | 'light';
  class?: string;
}
const { label, start, end, tone = 'orange', class: cls = '' } = Astro.props;
---
<div class:list={['kota', `kota--${tone}`, cls]} data-draw>
  {start && <span class="kota__end-label mono">{start}</span>}
  <svg class="kota__tick" viewBox="0 0 14 24" aria-hidden="true">
    <path d="M7 2v20M2 17L12 7" />
  </svg>
  <span class="kota__line"></span>
  {label && <span class="kota__label mono">{label}</span>}
  {label && <span class="kota__line"></span>}
  <svg class="kota__tick" viewBox="0 0 14 24" aria-hidden="true">
    <path d="M7 2v20M2 17L12 7" />
  </svg>
  {end && <span class="kota__end-label mono">{end}</span>}
</div>

<style>
  .kota {
    display: flex;
    align-items: center;
    gap: 0;
    color: var(--orange);
    min-width: 0;
  }

  .kota--ink {
    color: var(--ink);
  }

  .kota--light {
    color: var(--orange);
    --kota-text: var(--on-dark);
  }

  .kota__tick {
    width: 14px;
    height: 24px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .kota__line {
    flex: 1 1 0;
    min-width: 12px;
    height: 1.25px;
    background: currentColor;
    margin-inline: -7px;
    transform-origin: center;
    transition: transform 1.1s var(--ease-out);
  }

  .kota__label {
    flex: 0 1 auto;
    min-width: 0;
    text-align: center;
    padding: 0 0.75rem;
    color: var(--kota-text, var(--ink-2));
    white-space: nowrap;
    position: relative;
    top: -0.05em;
  }

  @media (max-width: 520px) {
    .kota__label {
      white-space: normal;
      text-wrap: balance;
      padding: 0 0.5rem;
    }

    .kota__end-label {
      padding-inline: 0.25rem;
    }
  }

  .kota__end-label {
    flex: none;
    color: var(--kota-text, var(--ink-2));
    padding-inline: 0.5rem;
  }

  :global(.kota.pre) .kota__line {
    transform: scaleX(0);
    transition: none;
  }

  :global(.kota.pre) .kota__label,
  :global(.kota.pre) .kota__end-label {
    opacity: 0;
  }

  .kota__label,
  .kota__end-label {
    transition: opacity 0.6s 0.45s var(--ease-out);
  }
</style>
